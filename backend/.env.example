# ═══════════════════════════════════════════════════════
#  Monvo — .env.example
#  NUSXA OLING: cp .env.example .env
#  Keyin barcha qiymatlarni to'ldiring.
#  Random kalit yaratish:
#    openssl rand -hex 32              (SECRET_KEY uchun)
#    openssl rand -hex 24              (DB/Redis parol uchun)
#    openssl rand -base64 18           (Admin parol uchun)
# ═══════════════════════════════════════════════════════

# ── App rejim ──────────────────────────────────────────
APP_ENV=production

# ── PostgreSQL (Docker ichida) ─────────────────────────
POSTGRES_DB=monvo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ALMASHTIR_KUCHLI_PAROL

# ── Database URL ───────────────────────────────────────
# DIQQAT: app to'g'ridan-to'g'ri `postgres:5432` ga ulanadi (pgbouncer chetda)
# Pgbouncer auth muammosi yechilgach `pgbouncer:5432` ga o'tkazish mumkin
DATABASE_URL=postgresql+asyncpg://postgres:ALMASHTIR_KUCHLI_PAROL@postgres:5432/monvo

# ── JWT Auth ───────────────────────────────────────────
SECRET_KEY=ALMASHTIR_RANDOM_32_BAYT_HEX
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Admin Panel ────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ALMASHTIR_ADMIN_PAROL
ADMIN_SECRET_KEY=ALMASHTIR_RANDOM_32_BAYT_HEX

# ── CORS ───────────────────────────────────────────────
ALLOWED_ORIGINS=https://monvo.uz,https://www.monvo.uz,https://app.monvo.uz

# ── Rate Limiting ──────────────────────────────────────
# Dashboard bitta yuklanishi ~10-20 so'rov yuboradi.
# Tez F5/refresh da limit oshmasligi uchun 600 tavsiya.
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30

# ── Redis ──────────────────────────────────────────────
REDIS_PASSWORD=ALMASHTIR_REDIS_PAROL
REDIS_URL=redis://:ALMASHTIR_REDIS_PAROL@redis:6379/0

# ── Google OAuth2 ──────────────────────────────────────
# Firebase Console → Project Settings → General → Web SDK setup
# yoki Google Cloud Console → APIs & Services → Credentials
# DIQQAT: eski `584058790525-...` kompromis (config.py validatsiya rad qiladi).
# Yangi client ID olib qo'y. Hozircha placeholder ishlatilsa boshqa auth ishlaydi.
GOOGLE_CLIENT_ID=placeholder.apps.googleusercontent.com

# ── Firebase FCM ───────────────────────────────────────
# firebase-adminsdk.json fayl backend/ ichida bo'lishi kerak
FIREBASE_SERVICE_ACCOUNT_JSON=/app/firebase-adminsdk.json

# ── Telegram Bot ───────────────────────────────────────
TELEGRAM_BOT_TOKEN=
FRONTEND_URL=https://monvo.uz

# ── SMTP (email) ───────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
SMTP_STARTTLS=true

# ── Eskiz.uz SMS ───────────────────────────────────────
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ── Payme to'lov ───────────────────────────────────────
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# ── OpenAI (landing chat vidjeti + admin/merchant AI yordamchi) ─────────
# platform.openai.com/api-keys → API kalit yarating
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PAYME_MIN_AMOUNT=1000
PAYME_MAX_AMOUNT=100000000

# ── Brute-force alert ──────────────────────────────────
ADMIN_ALERT_EMAIL=

# ── Monitoring (ixtiyoriy) ─────────────────────────────
SENTRY_DSN=
GLITCHTIP_URL=
GLITCHTIP_TOKEN=
METRICS_TOKEN=
